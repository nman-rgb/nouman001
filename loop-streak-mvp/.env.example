# Copy to .env for `vercel dev`, and add both values in
# Vercel → Project → Settings → Environment Variables.

# Apps Script → Deploy → Manage deployments → Web app URL (ends in /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Printed by setup() / showConfig() in the Apps Script execution log
RELAY_SECRET=paste-the-relay-secret-here
